---
import '../styles/global.css';
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.tsx';

const title = "Página Não Encontrada - Rainha da Pinha 2026";
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/lrpd26.svg">
  </head>

  <body class="bg-pattern-fluid min-h-screen flex flex-col">
    
    <Header client:load />

    <!-- Conteúdo Principal Centralizado -->
    <main class="flex-grow flex items-center justify-center relative overflow-hidden px-4 py-20">
      
      <!-- Efeito de Gradiente (mesmo estilo que usamos antes) -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#202BB0]/20 via-transparent to-[#202BB0]/10 -z-10"></div>

      <div class="max-w-2xl w-full text-center space-y-8">
        
        <!-- Elemento Visual 404 -->
        <div class="relative inline-block">
          <h1 class="text-9xl md:text-[12rem] font-black text-[#202BB0] opacity-20 select-none">
            404
          </h1>
          <div class="absolute inset-0 flex items-center justify-center">
            <img 
              src="/lrpd26.svg" 
              alt="Logo Rainha da Pinha" 
              class="w-32 md:w-48 animate-bounce"
            />
          </div>
        </div>

        <div class="space-y-4">
          <h2 class="text-3xl md:text-5xl font-bold text-[#202BB0] uppercase">
            Ops! Caminho errado.
          </h2>
          <p class="text-gray-700 text-lg md:text-xl max-w-md mx-auto">
            A página que você procura não existe ou foi movida. Que tal voltar para a programação oficial?
          </p>
        </div>

        <!-- Botão de Voltar com o efeito de hover que você gosta -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a 
            href="/" 
            class="px-8 py-4 bg-[#202BB0] text-white font-bold rounded-full text-lg transition-all duration-300 hover:scale-105 hover:shadow-xl active:scale-95"
          >
            Voltar para o Início
          </a>
          
          <a 
            href="/#programacao" 
            class="px-8 py-4 border-2 border-[#202BB0] text-[#202BB0] font-bold rounded-full text-lg transition-all duration-300 hover:bg-[#202BB0] hover:text-white"
          >
            Ver Programação
          </a>
        </div>

      </div>

      <!-- Detalhe decorativo (Pinha ou elemento do tema) -->
      <div class="absolute -bottom-10 -right-10 w-64 h-64 bg-[#202BB0] rounded-full blur-[120px] opacity-20"></div>
    </main>

    <Footer />

  </body>
</html>
